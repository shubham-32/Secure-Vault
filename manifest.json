{
  "manifest_version": 3,
  "name": "SecureVault",
  "description": "End-to-end encrypted password manager with autofill and generator.",
  "version": "1.0.0",
  "action": {
    "default_title": "SecureVault",
    "default_popup": "ui/popup.html"
  },
  "options_page": "ui/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "contextMenus",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "114"
}

